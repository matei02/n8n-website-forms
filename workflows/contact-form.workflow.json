        "subject": "Confirmation Email",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\" style=\"margin:0;padding:0;\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>PawPath – Thank You</title>\n  </head>\n  <body style=\"margin:0;padding:0;background-color:#f5f2e9;\">\n    <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f5f2e9;padding:24px 0;\">\n      <tr>\n        <td align=\"center\">\n          <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px;background-color:#ffffff;border-radius:12px;padding:32px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#2b2117;line-height:1.6;\">\n            <tr>\n              <td style=\"text-align:left;\">\n                <h1 style=\"margin:0 0 16px;font-size:22px;font-weight:600;color:#2b2117;\">\n                  Hello!\n                </h1>\n\n                <p style=\"margin:0 0 12px;font-size:15px;\">\n                  Thank you for your message. Our team will try to reply within\n                  <strong>24 hours</strong>, but it may take a little longer during\n                  periods of high traffic.\n                </p>\n\n                <p style=\"margin:20px 0 0;font-size:15px;\">\n                  Warm regards,<br />\n                  <strong>The PawPath Team</strong>\n                </p>\n\n                <p style=\"margin:8px 0 0;font-size:14px;\">\n                  <a href=\"<URL_2>\" style=\"color:#a8732f;text-decoration:none;\">\n                    <URL_3>\n                  </a>\n                </p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a50d9d26-a02c-552b-a247-9fbfd09cb108",
      "name": "Send a message",
